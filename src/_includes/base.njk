<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description"
        content="{{ description | default('Wildcat.chat - AI-powered Twitch bot platform featuring WildcatSage chatbot, WildcatTTS, and customizable chat overlays for streamers.') }}">
    <title>{{ title | default('Wildcat.chat - AI Tools for Twitch Streamers') }}</title>
    
    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="apple-touch-icon" href="/logo192.png">

    <!-- Resource hints -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://theme-proxy-361545143046.us-central1.run.app" crossorigin>

    <!-- Stylesheets -->
    <link rel="preload" as="style" href="/styles/reset.css">
    <link rel="preload" as="style" href="/styles/unified.css">
    <link rel="preload" as="style" href="/styles/components.css">
    {% for href in extraStyles %}<link rel="preload" as="style" href="{{ href }}">
    {% endfor %}
    <link rel="stylesheet" href="/styles/reset.css">
    <link rel="stylesheet" href="/styles/unified.css">
    <link rel="stylesheet" href="/styles/components.css">
    {# Page-specific CSS. Must stay after the site stylesheets above — overlay
       theming overrides unified.css by source order, not specificity.
       Nunjucks blocks do not work here: Eleventy renders the page first and
       injects it as `content`, so a child's {% block %} never reaches this head. #}
    {% for href in extraStyles %}<link rel="stylesheet" href="{{ href }}">
    {% endfor %}

    <!-- Fonts (Non-blocking) -->
    <link rel="preload" as="style"
        href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&family=Cabin+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap">
    <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&family=Cabin+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap"
        media="print" onload="this.media='all'">
    <noscript>
        <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,200..800;1,200..800&family=Cabin+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@300;400;500;600&display=swap">
    </noscript>

    <!-- Icons (Downloaded local script) -->
    <script src="/scripts/lucide.min.js"></script>

    <!-- Analytics -->
    <script src="https://app.rybbit.io/api/script.js" data-site-id="a1de59b65a61" defer></script>
</head>

<body class="has-navbar">
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <!-- Navigation Bar -->
    <nav class="site-navbar">
        <a href="/" class="site-navbar-brand">
            <svg class="wildcat-svg" viewBox="0 0 600 200" xmlns="https://www.w3.org/2000/svg" role="img"
                aria-label="Kaomoji reading '- ˕ •マ'">
                <style>
                    .kaomoji {
                        font-size: 250px;
                        font-family: 'Segoe UI Symbol', 'Arial Unicode MS', 'Noto Sans CJK JP', sans-serif;
                        fill: currentColor;
                        text-anchor: middle;
                        dominant-baseline: central;
                    }
                </style>
                <text x="50%" y="50%" class="kaomoji">- ˕ •マ</text>
            </svg>
        </a>
        <button class="navbar-toggle" aria-label="Toggle navigation" aria-expanded="false"
            aria-controls="site-navbar-menu"><i data-lucide="menu"></i></button>
        <ul class="site-navbar-menu" id="site-navbar-menu">
            <li><a href="/" {% if page.url == "/" %}class="active"{% endif %}>Home</a></li>
            <li><a href="/blog/" {% if page.url and page.url.startsWith("/blog/") %}class="active"{% endif %}>Blog</a></li>
            <li><a href="https://app.wildcat.chat">Wildcat Sage</a></li>
            <li><a href="https://tts.wildcat.chat">Wildcat TTS</a></li>
            <li><a href="/chat-overlay/" {% if page.url and page.url.startsWith("/chat-overlay/") %}class="active"{% endif %}>Chat Overlay</a></li>
            <li><a href="https://docs.wildcat.chat">Docs</a></li>
            <li><a href="https://parfaitfair.com/#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main id="main-content" tabindex="-1">
        {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 Wildcat.chat. All rights reserved.</p>
    </footer>

    <!-- Scripts -->
    <script src="/scripts/static-background.js" defer></script>
    <script src="/scripts/navigation.js" defer></script>
    {% for src in extraScripts %}<script type="module" src="{{ src }}"></script>
    {% endfor %}
    <script>
        (function() {
            function initIcons() {
                if (window.lucide && typeof window.lucide.createIcons === 'function') {
                    window.lucide.createIcons();
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initIcons);
            } else {
                initIcons();
            }
        })();
    </script>
</body>

</html>
