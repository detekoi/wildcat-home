{#- Shared app bar. Pages set in front matter:
      pageLabel   the mono label after the brand ("Home", "Blog", ...)
      activeTool  "overlay" to mark the Overlay chip as the current tool
      activeLink  "blog" to mark the Blog link as the current section
      docsHref    optional Docs target (the overlay pages link the overlay docs) -#}
<header class="wc-appbar">
    <div class="wc-appbar-brand">
        <a class="wch-brand" href="/">
            <img class="wch-brand-icon" src="/logo-nav.webp" alt="" width="22" height="22" decoding="async">
            <span class="wc-lockup">Wildcat</span>
        </a>
        <span class="wc-sep" aria-hidden="true"></span>
        <span class="wc-appbar-page">{{ pageLabel }}</span>
    </div>
    <nav class="wch-tools" aria-label="Open a Wildcat tool">
        <a class="wc-chipbtn" href="https://bot.wildcat.chat"><i data-lucide="bot" aria-hidden="true"></i>Sage</a>
        <a class="wc-chipbtn" href="https://tts.wildcat.chat"><i data-lucide="mic" aria-hidden="true"></i>TTS</a>
        <a class="wc-chipbtn{% if activeTool == 'overlay' %} wch-active{% endif %}" href="/chat-overlay/"{% if activeTool == 'overlay' %} aria-current="page"{% endif %}><i data-lucide="message-square" aria-hidden="true"></i>Overlay</a>
    </nav>
    <div class="wc-appbar-actions wch-actions">
        <span class="wch-rule wch-desk" aria-hidden="true"></span>
        <nav class="wch-links wch-desk" aria-label="Resources">
            <a class="wc-link wc-link--muted" href="{{ docsHref or 'https://docs.wildcat.chat' }}">Docs</a>
            {%- if activeLink == 'blog' %}
            <a class="wc-link" href="/blog/" aria-current="page">Blog</a>
            {%- else %}
            <a class="wc-link wc-link--muted" href="/blog/">Blog</a>
            {%- endif %}
            <a class="wc-link wc-link--muted" href="https://github.com/detekoi">GitHub</a>
        </nav>
        <div class="wc-themeswitch" role="group" aria-label="Color theme">
            <button type="button" data-theme-value="light" aria-pressed="false">Light</button>
            <button type="button" data-theme-value="dark" aria-pressed="false">Dark</button>
        </div>
    </div>
</header>
